{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["scope:web", "type:e2e", "platform:node"],
  "implicitDependencies": ["web", "api"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tools/scripts/web-e2e.sh"
      }
    },
    "e2e-raw": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config apps/web-e2e/playwright.config.mts --project=chromium"
      }
    }
  }
}
