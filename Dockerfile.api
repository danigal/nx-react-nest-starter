FROM node:24.20.0-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm nx run api:migration-build

FROM node:24.20.0-bookworm-slim AS runtime

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=3000 \
    MIGRATIONS_DIR=/app/drizzle
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
COPY --from=build --chown=node:node /workspace/dist/apps/api/package.json /workspace/dist/apps/api/pnpm-lock.yaml ./
COPY --from=build --chown=node:node /workspace/pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile
COPY --from=build --chown=node:node /workspace/dist/apps/api/ ./
COPY --from=build --chown=node:node /workspace/dist/apps/api-migrate/migrate.js ./migrate.js

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "main.js"]
